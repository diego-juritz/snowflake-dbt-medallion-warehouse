# Copy to .env (gitignored), fill in, then: set -a && source .env && set +a
SNOWFLAKE_ACCOUNT=<orgname-accountname>
SNOWFLAKE_USER=<your_user>
SNOWFLAKE_PRIVATE_KEY_PATH=<absolute/path/outside/repo/rsa_key.p8>
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_ROLE=<role_with_access_to_the_project_schemas>
SNOWFLAKE_WAREHOUSE=<xsmall_auto_suspending_warehouse>
SNOWFLAKE_DATABASE=MEDALLION
# Optional. Isolates your objects: DEV_JDOE -> DEV_JDOE_BRONZE / _SILVER / _GOLD
DBT_SCHEMA_PREFIX=
